# Copy this file to .env and replace the local database password.
DB_URL=jdbc:postgresql://localhost:55432/liga_copa_peru
DB_USERNAME=liga_app
DB_PASSWORD=change-this-to-a-local-secret

POSTGRES_HOST_PORT=55432
SQLSERVER_HOST=JANSJIMENEZ
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=liga_copa_peru
PORT=8080
LEAGUE_NAME=Liga Copa Perú
# Leave empty until explicitly configuring the administrator in the app environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false
THYMELEAF_CACHE=false
